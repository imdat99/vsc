{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hono-vue",
  "compatibility_date": "2025-08-03",
  "main": "./dist/server/index.js",
  "compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": "dist/public",
		"html_handling": "none"
	},
	"observability": {
		"enabled": true
	}
}